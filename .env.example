# OpenRouter key — both models route through it
OPENROUTER_API_KEY=

# Model names, in OpenRouter's "provider/model" naming
CHEAP_MODEL=openai/gpt-4o-mini
STRONG_MODEL=openai/gpt-4o-mini

# Storage
DATABASE_URL=sqlite:///data/dhaga.db

# Row-level confidence below which the evaluator (strong model) runs
CONFIDENCE_THRESHOLD=0.7

# Fraction of high-confidence rows to audit anyway, to measure agreement
AUDIT_SAMPLE_RATE=0.05
